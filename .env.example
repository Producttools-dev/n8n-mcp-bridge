# ─────────────────────────────────────────────────────────────────────────────
# TenantVibe MCP Backend — Environment Variables
# Copy this file to .env and fill in real values for local development.
# In production (Render), set these via the Render dashboard Environment tab.
# ─────────────────────────────────────────────────────────────────────────────

# ── Primary PMS (Buildium, AppFolio, etc.) ───────────────────────────────────
PMS1_API_URL=https://your-pms1-api.example.com
PMS1_API_KEY=your-pms1-api-key

# ── Secondary PMS / Billing / Ticketing ──────────────────────────────────────
PMS2_API_URL=https://your-pms2-api.example.com
PMS2_API_KEY=your-pms2-api-key

# ── GoHighLevel CRM ──────────────────────────────────────────────────────────
GHL_API_URL=https://services.leadconnectorhq.com
GHL_API_KEY=your-ghl-api-key
GHL_LOCATION_ID=your-ghl-location-id
